                          description="Derived Column Expression"
                          name="Expression">#{Package\Data DIM_PRODUCT\OLE DB Product Origin.Outputs[OLE DB Source Output].Columns[product_line_name]} == "Food and beverages" ? "Alimentos y Bebidas" : (#{Package\Data DIM_PRODUCT\OLE DB Product Origin.Outputs[OLE DB Source Output].Columns[product_line_name]} == "Electronic accessories" ? "Tecnología y Electro" : (#{Package\Data DIM_PRODUCT\OLE DB Product Origin.Outputs[OLE DB Source Output].Columns[product_line_name]} == "Sports and travel" ? "Deportes y Viajes" : (#{Package\Data DIM_PRODUCT\OLE DB Product Origin.Outputs[OLE DB Source Output].Columns[product_line_name]} == "Home and lifestyle" ? "Hogar y Estilo de Vida" : (#{Package\Data DIM_PRODUCT\OLE DB Product Origin.Outputs[OLE DB Source Output].Columns[product_line_name]} == "Health and beauty" ? "Salud y Belleza" : (#{Package\Data DIM_PRODUCT\OLE DB Product Origin.Outputs[OLE DB Source Output].Columns[product_line_name]} == "Fashion accessories" ? "Accesorios de Moda" : #{Package\Data DIM_PRODUCT\OLE DB Product Origin.Outputs[OLE DB Source Output].Columns[product_line_name]})))))</property>
